PORT=4000
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_GEO_URL=https://api.openweathermap.org/geo/1.0
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174
CACHE_TTL_SECONDS=600
LOG_LEVEL=info

GROQ_API_KEY=your_api_key_here
GROQ_BASE_URL=https://api.groq.com
# Model rationale: text = Groq's current best general text model; vision = image-capable.
# Check https://console.groq.com/docs/models before deploy — replace if deprecated.
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MAX_TOKENS=4500
GROQ_TIMEOUT_MS=30000

# Shared bearer token for /api/admin/usage. Rotate if exposed.
ADMIN_TOKEN=

